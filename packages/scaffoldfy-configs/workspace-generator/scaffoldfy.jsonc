{
  "$schema": "../node_modules/@pixpilot/scaffoldfy/schema/scaffoldfy.schema.json",
  // "extends": ["../workspace-initializer/scaffoldfy.json"],
  "name": "pnpm-turbo-monorepo-template-setup",
  "description": "Generate workspace with apps and packages",
  "prompts": [
    {
      "id": "workspaceApps",
      "type": "checkbox",
      "message": "Select the apps to include:",
      "choices": [
        {
          "name": "Library",
          "value": "library"
        },
        {
          "name": "Next.js",
          "value": "nextjs"
        },
        {
          "name": "Chrome Extension",
          "value": "chrome-extension"
        },
        {
          "name": "Expo",
          "value": "expo"
        }
      ]
    },
    {
      "id": "nextjsVisualTest",
      "type": "input",
      "message": "Next.js visual-test value:",
      "enabled": {
        "type": "condition",
        "value": "workspaceApps.includes('nextjs')"
      }
    },
    {
      "id": "expoVisualTest",
      "type": "input",
      "message": "Expo visual-test value:",
      "enabled": {
        "type": "condition",
        "value": "workspaceApps.includes('expo')"
      }
    }
  ],
  "tasks": [
    {
      "id": "clone-monorepo-template",
      "name": "Clone Monorepo Template",
      "description": "Clone the monorepo template",
      "type": "exec",
      "config": {
        "command": "git clone https://github.com/pixpilot/pnpm-turbo-monorepo-template.git"
      }
    }
  ]
}
