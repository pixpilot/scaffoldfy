{
  "$schema": "../node_modules/@pixpilot/scaffoldfy/schema/scaffoldfy.schema.json",
  // "extends": ["../workspace-initializer/scaffoldfy.json"],
  "name": "pnpm-turbo-monorepo-template-setup",
  "description": "Generate workspace with apps and packages",
  "prompts": [
    {
      "id": "workspaceApps",
      "type": "checkbox",
      "message": "Select the apps to include:",
      "choices": [
        {
          "name": "Library",
          "value": "library"
        },
        {
          "name": "Next.js Cloudflare",
          "value": "nextjs-cloudflare"
        },
        {
          "name": "Chrome Extension",
          "value": "chrome-extension"
        },
        {
          "name": "Expo",
          "value": "expo"
        }
      ]
    }
    // {
    //   "id": "workspaceTools",
    //   "type": "checkbox",
    //   "message": "Select the packages to include:",
    //   "choices": [
    //     {
    //       "name": "storybook",
    //       "value": "storybook"
    //     }
    //   ]
    // }
    // {
    //   "id": "nextjsVisualTest",
    //   "type": "input",
    //   "message": "Next.js visual-test value:",
    //   "enabled": {
    //     "type": "condition",
    //     "value": "workspaceApps.includes('nextjs')"
    //   }
    // },
  ],
  "tasks": [
    {
      "id": "setup-workspace",
      "name": "Set up workspace apps",
      "description": "Clone the monorepo template and add each selected app",
      "type": "exec-file",
      "config": {
        "file": "./scripts/setup-workspace.cjs",
        "runtime": "node",
        "parameters": {
          "WORKSPACE_APPS": "{{workspaceApps}}"
        }
      }
    }
  ]
}
